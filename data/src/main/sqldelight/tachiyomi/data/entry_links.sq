CREATE TABLE entry_links(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    entry_id_a INTEGER NOT NULL,
    entry_id_b INTEGER NOT NULL,
    relation_type TEXT NOT NULL DEFAULT 'adaptation',
    FOREIGN KEY(entry_id_a) REFERENCES mangas (_id)
    ON DELETE CASCADE,
    FOREIGN KEY(entry_id_b) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

-- Callers are expected to pass entry_id_a < entry_id_b (see EntryLinkRepositoryImpl) so a pair
-- can't be inserted twice in reversed order.
CREATE UNIQUE INDEX entry_links_pair_index ON entry_links(entry_id_a, entry_id_b);
CREATE INDEX entry_links_entry_id_a_index ON entry_links(entry_id_a);
CREATE INDEX entry_links_entry_id_b_index ON entry_links(entry_id_b);

insert:
INSERT OR IGNORE INTO entry_links(entry_id_a, entry_id_b, relation_type)
VALUES (:entryIdA, :entryIdB, :relationType);

delete:
DELETE FROM entry_links
WHERE (entry_id_a = :entryIdA AND entry_id_b = :entryIdB)
OR (entry_id_a = :entryIdB AND entry_id_b = :entryIdA);

getLinkedEntryId:
SELECT CASE WHEN entry_id_a = :entryId THEN entry_id_b ELSE entry_id_a END AS linkedEntryId
FROM entry_links
WHERE entry_id_a = :entryId OR entry_id_b = :entryId
LIMIT 1;
